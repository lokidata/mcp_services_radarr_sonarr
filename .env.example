# Copy to .env and fill in. Used by docker compose.
NAS_IP=192.168.1.10
RADARR_PORT=7878
SONARR_PORT=8989
RADARR_API_KEY=your_radarr_api_key
SONARR_API_KEY=your_sonarr_api_key

# Optional media servers (watched status)
EMBY_BASE_URL=
EMBY_API_KEY=
EMBY_USER_ID=
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
PLEX_BASE_URL=
PLEX_TOKEN=

# Host port published by docker compose (the container always listens on 3000)
MCP_SERVER_PORT=3000
