{
  "mcpServers": {
    "radarr_sonarr": {
      "command": "uv",
      "args": [
        "--directory", "/path/to/mcp_services_radarr_sonarr",
        "run", "radarr-sonarr-mcp", "start"
      ],
      "env": {
        "NAS_IP": "192.168.1.10",
        "RADARR_PORT": "7878",
        "SONARR_PORT": "8989",
        "RADARR_API_KEY": "your_radarr_api_key",
        "SONARR_API_KEY": "your_sonarr_api_key",
        "MCP_SERVER_PORT": "3000",
        "JELLYFIN_BASE_URL": "",
        "JELLYFIN_API_KEY": "",
        "JELLYFIN_USER_ID": "",
        "EMBY_BASE_URL": "",
        "EMBY_API_KEY": "",
        "EMBY_USER_ID": "",
        "PLEX_BASE_URL": "",
        "PLEX_TOKEN": ""
      }
    }
  }
}
